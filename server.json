{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.davesheffer/hunch",
  "description": "Engineering memory for AI-assisted codebases: decisions, bug lineage and invariants, over MCP.",
  "repository": {
    "url": "https://github.com/davesheffer/hunch",
    "source": "github"
  },
  "websiteUrl": "https://hunch-pi.vercel.app",
  "version": "1.20.2",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@davesheffer/hunch",
      "version": "1.20.2",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Start the Hunch MCP server (stdio) for the current repository."
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
