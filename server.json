{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.davesheffer/hunch",
  "description": "Shared records for AI agents: engineering decisions, bug history, rules, and work state through MCP.",
  "repository": {
    "url": "https://github.com/davesheffer/hunch",
    "source": "github"
  },
  "websiteUrl": "https://www.hunchmemory.com",
  "version": "1.38.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@davesheffer/hunch",
      "version": "1.38.1",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Start the Hunch MCP server (stdio) for the current repository."
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
